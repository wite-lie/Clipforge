<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.clipforge</groupId>
    <artifactId>clipforge-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ClipForge Agent Multi-Module Parent</name>
    <description>ClipForge Agent（创作规划智能体）多模块父工程。</description>

    <modules>
        <module>clipforge-dependencies</module>
        <module>clipforge-common</module>
        <module>clipforge-contract</module>
        <module>clipforge-ai-api</module>
        <module>clipforge-ai-infrastructure</module>
        <module>clipforge-observability</module>
        <module>clipforge-messaging</module>
        <module>clipforge-module-knowledge</module>
        <module>clipforge-module-material</module>
        <module>clipforge-module-memory</module>
        <module>clipforge-module-creation</module>
        <module>clipforge-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <langchain4j.version>1.15.1</langchain4j.version>
        <mockito.version>5.20.0</mockito.version>
        <archunit.version>1.4.1</archunit.version>
        <mybatis-plus.version>3.5.14</mybatis-plus.version>
        <rocketmq-spring.version>2.3.6</rocketmq-spring.version>
        <tika.version>3.2.3</tika.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <parameters>true</parameters>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <file.encoding>UTF-8</file.encoding>
                            <sun.stdout.encoding>UTF-8</sun.stdout.encoding>
                            <sun.stderr.encoding>UTF-8</sun.stderr.encoding>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

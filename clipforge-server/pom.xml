<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.clipforge</groupId>
        <artifactId>clipforge-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>clipforge-server</artifactId>
    <name>ClipForge Server</name>
    <description>ClipForge Agent（创作规划智能体）可运行服务模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-contract</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-module-creation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-module-material</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-module-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-module-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.clipforge.server.ClipForgeServerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
